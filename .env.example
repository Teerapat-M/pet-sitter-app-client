# Local backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production (Render):
# NEXT_PUBLIC_API_URL=https://pet-sitter-app-server.onrender.com

# Stripe TEST publishable key only (same account as server sk_test). Never put sk_ here.
# Phase 3 checkout redirects to checkoutUrl from POST /api/bookings.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase Auth (browser / OAuth + reset-password links)
# Copy Project URL + anon public key from Supabase → Project Settings → API
# Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
